{
  "name": "@world/client",
  "version": "0.1.0",
  "private": true,
  "description": "PROJECT WORLD browser client (Phaser 3 renderer + React UI).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "e2e": "playwright test --trace off",
    "art:preview": "tsx scripts/preview-art.ts"
  },
  "dependencies": {
    "@world/shared": "workspace:*",
    "galmuri": "2.40.3",
    "phaser": "3.90.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "vite": "8.3.8",
    "tsx": "4.23.15"
  }
}
